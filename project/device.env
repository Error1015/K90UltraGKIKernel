# ---------------------------------------------------------------------------
# 本仓库只服务一台机器：Redmi K90 Ultra（warsaw / SM8750）。
# 这里是与构建结果绑定的全部基准值，所有脚本都从这里取，不再由 workflow 输入决定。
#
# 换机型或换内核版本 = 只改这个文件，其它一律不动。
# 注意：下面用的是普通赋值，会覆盖外部环境里的同名变量 —— 这是故意的，
#       避免 CI 上一次手滑填错版本，编出一个 KMI 不匹配的内核。
# ---------------------------------------------------------------------------

DEVICE=warsaw
SOC=sm8750

# 内核版本：必须与手机 uname -r 的 "6.6.118" 完全一致
KERNEL_RELEASE=6.6.118

# 对应的 ACK 发布 tag（写死，不再每次去 googlesource 解析）
KERNEL_TAG=android15-6.6.118_r00

# 源码分支（repo init 用）
ANDROID_BRANCH=android15-6.6
# 注意：不要用 common-android15-6.6-lts。
# 那个清单是精简版，只含 common + prebuilts，不带 kernel/build、kleaf 这些
# 构建框架项目 —— 结果就是 brew 级 build.sh / tools/bazel 都找不到。
# 完整清单是 common-<branch>（不带 -lts）。
MANIFEST_BRANCH=common-android15-6.6

# 版本串不在这里写。
# 厂商模块的 vermagic 是整串严格比对，必须与原厂一字不差
# （原厂是 6.6.118-android15-8-g0908354dac1b-ab16143355-4k）。
# 这个值在 lib.sh 里从 firmware/boot-template.json 的 stock_kernel_version 推出来，
# 换机型/换固件时重新生成模板即可，不会出现"手写漏一段 → 卡 logo"。

# 页大小 / boot 分区大小（4K 页，96MB 分区，都来自原厂镜像实测）
PAGE_SIZE=4096
PARTITION_SIZE=100663296

# SUSFS 内核侧补丁的分支
SUSFS_BRANCH=gki-android15-6.6

# ---------------------------------------------------------------------------
# 构建引擎
#   script —— 走 ACK 自带的 build/build.sh（BakaSU / AOSP 官方文档的写法）：
#             LTO=thin BUILD_CONFIG=common/build.config.gki.aarch64 build/build.sh
#             它会把工具链、KCFLAGS、POST_DEFCONFIG_CMDS 全按 build.config 设好，
#             产物才是 Google 验证过的那个形态。
#   make   —— 裸 `make O=out Image`。能编出来，但少了 build.sh 的那层预处理。
#
# 之前一直用 make，这条路下「原厂配置」编出来的内核刷进去起不来；
# 现在换成官方 script 路径再验一次。
#
# 注意：这里必须写硬赋值。workflow 会用 grep '^[A-Z_]\+=' 把本文件整段塞进
# $GITHUB_ENV，写成 ${VAR:-default} 的话，值会带着字面引号和花括号进环境变量。
# ---------------------------------------------------------------------------
BUILD_ENGINE=script
