# 基础配置：所有构建都会应用
# 这些是 KernelSU 系 root、SUSFS 模块、以及常见 metamodule 的公共前提。

# overlayfs / tmpfs：模块挂载与 xattr 支持
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# 符号表：SUSFS 与部分模块需要完整 kallsyms
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# fanotify：SUSFS 的 sus_path / 文件监控相关特性依赖
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y

# 关闭 -Werror：第三方内核补丁（SUSFS/BBG/NTSync）在较新 ACK 上常带无害 warning，
# 开启 WERROR 会让构建直接失败。真正的编译错误依然会中断构建。
CONFIG_WERROR=n

# 关掉导出符号裁剪（保险项）。
# GKI 默认会按 android/abi_gki_aarch64 白名单裁掉"没人用"的导出符号，
# 但厂商 vendor_dlkm 里的模块是按他们自己的 abi_gki_aarch64_qcom / _xiaomi
# 符号表构建的，一旦用到白名单外的符号就会 "unknown symbol in module"，
# 表现是内核起来了、厂商模块没起来，卡在开机 logo。
# 全量导出只是让镜像大 1~2MB，代价远小于一次卡标排查。
CONFIG_TRIM_UNUSED_KSYMS=n
