# DroidSpaces-OSS 容器运行时所需的完整配置集
# 与上游 Documentation/resources/... 的 GKI 配置清单保持一致，
# 这样即使不勾选 Networking，DroidSpaces 也是自洽的。

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y

# 设备节点
CONFIG_DEVTMPFS=y

# binfmt：容器里跑发行版二进制
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_ELF=y

# tmpfs 的 xattr / POSIX ACL（NixOS 等）
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# 网络：增强 NAT
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y

# UFW 的 reject target（注意：不是 NETFILTER_XT_TARGET_REJECT）
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# fail2ban
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
