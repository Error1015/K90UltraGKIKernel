# DroidSpaces-OSS 容器运行时
# 与上游 Documentation/resources 里的 GKI 配置清单对齐，
# 这样即使不勾 networking，DroidSpaces 自己也是自洽的。
# 注意：出厂配置里 SYSVIPC / USER_NS / PID_NS / IPC_NS / TMPFS_XATTR 都是关的。

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y

# 设备节点
CONFIG_DEVTMPFS=y

# binfmt：容器里跑发行版二进制
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_ELF=y

# tmpfs 的 xattr / POSIX ACL（NixOS 等）
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# 网络：容器 NAT
CONFIG_MACVLAN=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# UFW 的 reject target（注意不是 NETFILTER_XT_TARGET_REJECT）
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# fail2ban 用的 ipset
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
