# 网络增强：BBRv3 / WireGuard / IPSet / CIFS
#
# BBR 算法本身：出厂配置里已经是 y，显式再写一遍防止将来变动。
# 默认拥塞控制指向 bbr 时，BBR 必须是内建（=y），不能是模块。
CONFIG_TCP_CONG_BBR=y

# 默认拥塞控制由 net/ipv4/Kconfig 的 choice 决定，三个成员互斥：
#   DEFAULT_CUBIC / DEFAULT_BBR / DEFAULT_RENO
# 必须直接选 DEFAULT_BBR —— CONFIG_DEFAULT_TCP_CONG 是没有 prompt 的 string，
# 只是 choice 推导出来的结果，直接写它会被 olddefconfig 按默认值重算回 cubic。
CONFIG_DEFAULT_CUBIC=n
CONFIG_DEFAULT_BBR=y

# 常用队列调度
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# WireGuard（出厂已是 y，显式保留）
CONFIG_WIREGUARD=y

# IPSet / iptables 扩展（防火墙规则、fail2ban、按地址集匹配都要）
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_NETFILTER_XT_SET=y
# 注意是 MATCH_ADDRTYPE（匹配模块），不是 TARGET_REJECT
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# CIFS（SMB 共享）
CONFIG_CIFS=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_DFS_UPCALL=y
